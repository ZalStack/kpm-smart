DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect ke HTTPS jika HTTP
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Blokir akses langsung ke file sensitif
    RewriteRule ^\.env - [F,L]
    RewriteRule ^composer\.(json|lock) - [F,L]
    RewriteRule ^package(-lock)?\.json$ - [F,L]
    RewriteRule ^(phpunit\.xml|\.php-ini) - [F,L]
    RewriteRule ^(artisan|vite\.config\.js|postcss\.config\.js|tailwind\.config\.js)$ - [F,L]
    RewriteRule ^(bootstrap|database|app|routes|tests)/ - [F,L]
    RewriteRule ^storage/(app|framework|logs)/ - [F,L]

    # Akses /storage/... diarahkan ke public/index.php agar dilayani route storage
    RewriteRule ^storage/(.*)$ public/index.php [L]

    # 1. Request root langsung arahkan ke public/index.php
    RewriteRule ^$ public/index.php [L]

    # 2. Jika file fisik ada di dalam folder public, sajikan langsung
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # 3. Semua request route aplikasi lainnya kirim ke public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
