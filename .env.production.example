# =============================================================
# TEMPLATE KONFIGURASI PRODUKSI (HARDENED) — KPM Smart
#
# Salin file ini menjadi `.env` di server, lalu sesuaikan nilainya.
# JANGAN menyalin `.env` dari mesin lokal: APP_KEY dan password database
# lokal dianggap sudah bocor dan wajib diganti.
#
# WAJIB sebelum go-live:
#   1. php artisan key:generate              -> isi APP_KEY
#   2. php artisan app:make-admin --email=... -> buat akun admin
#   3. php artisan config:cache && route:cache && view:cache
# =============================================================

APP_NAME="KPM Smart"
APP_ENV=production
# WAJIB: generate key baru untuk produksi -> php artisan key:generate
APP_KEY=
# JANGAN diubah ke true di production: halaman error akan membocorkan stack
# trace, isi environment variable, dan query database.
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Jangan pakai "debug" di production: log jadi jauh lebih besar tanpa manfaat.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kpm-smart
# Buat user MySQL khusus untuk aplikasi ini, jangan memakai root.
DB_USERNAME=kpm_smart
# Password kuat & unik, berbeda dari password lokal.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Enkripsi data session di storage
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true
# Cookie tidak bisa dibaca JavaScript (anti XSS mencuri session)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Catatan: aplikasi ini TIDAK punya queue job, jadi tidak perlu queue worker
# di shared hosting. Yang dibutuhkan hanya cron `schedule:run` (lihat README).
QUEUE_CONNECTION=database

CACHE_STORE=database

# =============================================================
# TOKEN API (Sanctum)
# =============================================================
# Masa berlaku token API dalam menit. Default 1440 = 24 jam.
# Isi 0 hanya jika Anda benar-benar ingin token tidak pernah expired.
SANCTUM_TOKEN_EXPIRATION=1440

# =============================================================
# CORS
# =============================================================
# Origin browser yang boleh memanggil API, pisahkan dengan koma.
# Native app (Android/iOS) tidak picky CORS, jadi cukup diisi untuk web admin
# dan domain lain yang memang memakai API.
CORS_ALLOWED_ORIGINS=https://domain-anda.com,https://app.domain-anda.com
# Untuk origin dengan banyak subdomain:
# CORS_ALLOWED_ORIGIN_PATTERNS=https://*.domain-anda.com

# =============================================================
# PUSH NOTIFICATION (WAJIB DIISI)
# =============================================================
# Generate dengan: php artisan web-push:generate-vapid-keys
# Kalau kosong, fitur notifikasi push otomatis dinonaktifkan (tidak error).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# =============================================================
# INTEGRASI WEB INDUK / MASTER APP
# =============================================================
# Base URL aplikasi induk. Kalau kosong/tidak hidup, auto-sync saat login dan
# laporan mingguan ke orang tua dilewati dengan aman (tidak menggagalkan login).
PARENT_APP_URL=

# =============================================================
# PENGIRIMAN EMAIL
# =============================================================
# Sistem memakai mailer bawaan Laravel. WAJIB diisi, karena email Enroll Key dan
# reset password dikirim lewat Laravel Mail. Kalau dibiarkan "log", email tidak
# terkirim dan hanya ditulis ke storage/logs/laravel.log.
#
# Opsi 1 — sendmail (butuh sendmail/postfix terpasang di server):
#   MAIL_MAILER=sendmail
# Opsi 2 — SMTP relay (disarankan di shared hosting):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.domain-anda.com
#   MAIL_PORT=587
#   MAIL_USERNAME=...
#   MAIL_PASSWORD=...
#   MAIL_ENCRYPTION=tls
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
