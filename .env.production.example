# =============================================================
# TEMPLATE KONFIGURASI PRODUKSI (HARDENED)
# Salin file ini ke .env saat deploy ke server produksi, lalu
# sesuaikan nilai domain/database/kunci. JANGAN pakai APP_DEBUG=true.
# =============================================================

APP_NAME="KPM Belajar Online"
APP_ENV=production
# WAJIB: generate key baru untuk produksi -> php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=membership-system
DB_USERNAME=isikan_user_db_khusus
# Gunakan password database yang kuat & unik, bukan password yang sama dengan lokal
DB_PASSWORD=

MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Enkripsi data session di storage
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true
# Cookie tidak bisa dibaca JavaScript (anti XSS mencuri session)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# =============================================================
# PENGIRIMAN EMAIL
# Sistem memakai fungsi mail() bawaan PHP (tanpa library/SMTP).
# Pastikan server produksi memiliki sendmail/postfix terkonfigurasi.
#
# PENTING: MAIL_MAILER wajib diatur, karena email Enroll Key dikirim
# lewat Laravel Mail. Tanpa ini defaultnya "log" — email tidak akan
# terkirim dan hanya ditulis ke storage/logs/laravel.log!
# =============================================================
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
